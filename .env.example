# ============================================================
# Última Instância — variáveis de ambiente
# Copie para .env (local) ou configure no EasyPanel (Environment).
# Sem nenhuma variável de banco, o jogo sobe em MODO MOCK: jogável
# e testável, com login de demonstração e juízes fictícios.
# ============================================================

# ---- servidor ----
PORT=3000
SEMESTRE=2026-2
# segredo para assinar a sessão (cookie). OBRIGATÓRIO em produção: com NODE_ENV=production
# e sem este valor, o servidor NÃO SOBE (falha rápido) — porque um segredo efêmero deslogaria
# a turma inteira a cada restart. Gere um aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# duração da sessão em horas (padrão 12)
SESSION_HORAS=12
# defina como 'production' atrás de HTTPS para o cookie sair como Secure
NODE_ENV=production

# ---- USUÁRIO FIXO (login por env, sem precisar do banco) ----
# Enquanto o Postgres não entra, use este acesso: o aluno entra com este
# CPF e esta data de nascimento. Digite SÓ NÚMEROS no CPF (a máscara com
# pontos e traço é visual; o backend recebe só os 11 dígitos).
# Continua funcionando como conta de teste mesmo depois do banco entrar;
# para desligá-lo, é só apagar estas três linhas.
USUARIO_FIXO_CPF=12345678909
USUARIO_FIXO_NASCIMENTO=1990-01-01
USUARIO_FIXO_NOME=Equipe TI FMP
# opcionais do usuário fixo:
# USUARIO_FIXO_SEMESTRE=2026-2
# USUARIO_FIXO_RA=0000
# USUARIO_FIXO_ADMIN=true   # dá a este acesso o painel de coordenação (ranking da turma + CSV)

# ---- Postgres (deixe em branco por enquanto; preencha quando o banco entrar) ----
# forma 1: string única
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
# forma 2: variáveis separadas (usadas se DATABASE_URL estiver vazia)
# PGHOST=postgres
# PGPORT=5432
# PGUSER=ultima
# PGPASSWORD=troque-me
# PGDATABASE=ultima_instancia
# TLS no Postgres: 'require' liga (com rejectUnauthorized:false). Vazio = desligado.
# PGSSL=

# ---- nomes de tabela (só se forem diferentes do padrão) ----
# TABELA_USUARIOS=usuarios
# TABELA_DISCIPLINAS=disciplinas
# TABELA_PARTIDAS=partidas

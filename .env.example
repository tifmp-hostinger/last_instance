# ============================================================
# Última Instância — variáveis de ambiente
# Copie para .env (local) ou configure no EasyPanel (Environment).
# Sem nenhuma variável de banco, o jogo sobe em MODO MOCK: jogável
# e testável, com login de demonstração e juízes fictícios.
# ============================================================

# ---- servidor ----
PORT=3000
SEMESTRE=2026-2
# segredo para assinar a sessão (cookie). GERE UM ALEATÓRIO em produção:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# duração da sessão em horas (padrão 12)
SESSION_HORAS=12
# defina como 'production' atrás de HTTPS para o cookie sair como Secure
NODE_ENV=production

# ---- Postgres (escolha UMA das duas formas) ----
# forma 1: string única
DATABASE_URL=postgres://usuario:senha@host:5432/banco
# forma 2: variáveis separadas (usadas se DATABASE_URL estiver vazia)
# PGHOST=postgres
# PGPORT=5432
# PGUSER=ultima
# PGPASSWORD=troque-me
# PGDATABASE=ultima_instancia
# TLS no Postgres: 'require' liga (com rejectUnauthorized:false). Vazio = desligado.
# PGSSL=

# ---- nomes de tabela (só se forem diferentes do padrão) ----
# TABELA_USUARIOS=usuarios
# TABELA_DISCIPLINAS=disciplinas
# TABELA_PARTIDAS=partidas

# ---- login de demonstração (só vale no MODO MOCK, sem banco) ----
DEMO_CPF=00000000000
DEMO_NASCIMENTO=2000-01-01
DEMO_NOME=Aluno de demonstração
